# ========================================================
# VEGAS ONE (vegasone.games) PRODUCTION & DEV CONFIGURATION
# ========================================================

# 1. MongoDB Database Connection
# For local VPS: mongodb://localhost:27017/vegas_one
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/vegas_one?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/vegas_one

# 2. Security & Session Secrets
JWT_SECRET=vegas_one_super_secret_jwt_key_2026_luxury_casino

# 3. Domain URL
NEXT_PUBLIC_APP_URL=https://vegasone.games

# 4. USA-Only Geo-Lock Configuration
# In development, set to true to test locally.
# In production on Hostinger VPS, set to false for strict USA-only geo enforcement.
BYPASS_GEO_LOCK=true

# 5. SMTP Email Configuration (Nodemailer)
# Hostinger SMTP default: smtp.hostinger.com (Port 465 SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@vegasone.games
SMTP_PASS=your_email_password_here
SMTP_FROM=support@vegasone.games

# 6. Firebase Cloud Messaging (Push Notifications)
# Place your Firebase Admin Service Account JSON at root: ./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# 7. Mobile App (Capacitor) Remote Server Target
CAPACITOR_SERVER_URL=https://vegasone.games
